# Copy this file to `.env` and fill in GROQ_API_KEY. `.env` is git-ignored; never commit it.
# Create a key in the Groq console. Check your plan and limits there:
#   https://console.groq.com/settings/limits

GROQ_API_KEY=

# Model ID. Must support strict JSON-schema structured output on Groq.
GROQ_MODEL=openai/gpt-oss-20b

# Per-request timeout (seconds) and bounded retries (extra attempts after the first).
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2

# Longest `retry-after` (seconds) the app will wait out after a per-minute rate limit.
GROQ_MAX_RETRY_WAIT_SECONDS=10

# low | medium | high. Leave empty to omit (for models without reasoning controls).
GROQ_REASONING_EFFORT=low

# Cap on generated tokens per request (includes reasoning tokens).
GROQ_MAX_COMPLETION_TOKENS=2500

# Input limits (words). Text is sent to the API in chunks of at most MAX_CHUNK_WORDS.
MAX_INPUT_WORDS=1000
MAX_CHUNK_WORDS=400
